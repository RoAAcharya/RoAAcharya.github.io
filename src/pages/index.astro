---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import ResearchCard from "../components/ResearchCard.astro";
import ComplexityBackground from "../components/ComplexityBackground.astro"
---

<Layout
  ><Navbar />
  <section class="hero-wrap">
  <ComplexityBackground />
<Hero /><section class="container">
    <h2>Research Interests</h2><div class="cards">
      <ResearchCard
        title="Algorithmic method"
        description="How can we leverage non-trivial positive results about the feasibility of certain algorithmic tasks, to demonstrate separations between complexity classes?"
      /><ResearchCard
        title="Uniformity"
        description="  How can we tailor state of the art arguments for separating complexity classes to take advantage of uniformity? How does this interact with meta-computational notions?"
      /><ResearchCard
        title="Explicit Constructions"
        description="  For what classes of objects can we develop explicit constructions of them?"
      />
      <ResearchCard title="Meta-complexity"
      description="  How do meta-computational notions such as time-bounded Kolmogorov complexity and circuit size interact with all of the above questions?"
      />
    </div>
  </section>
</section>
  <Footer /></Layout
>
 
    